rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function householdData(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function isHouseholdMember(householdId) {
      return signedIn()
        && request.auth.uid in householdData(householdId).memberIds;
    }

    function validPersonId(personId) {
      return personId == 'alex' || personId == 'nathalia';
    }

    function validExceptionKind(kind) {
      return kind == 'home'
        || kind == 'late_shift'
        || kind == 'work_trip'
        || kind == 'day_off'
        || kind == 'holiday'
        || kind == 'away';
    }

    function validScheduleExceptionFields(data) {
      return data.keys().hasOnly([
          'personId', 'kind', 'date', 'endDate', 'title', 'location', 'createdBy', 'createdAt'
        ])
        && validPersonId(data.personId)
        && validExceptionKind(data.kind)
        && data.date is string
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (data.endDate == null || (data.endDate is string
          && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.endDate >= data.date))
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && (data.location == null || data.location is string);
    }

    function validNewScheduleException(data) {
      return validScheduleExceptionFields(data)
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time;
    }

    function validMealPlan(data) {
      return data.keys().hasOnly([
          'weekStart', 'days', 'sourceFingerprint', 'savedBy', 'savedAt'
        ])
        && data.weekStart is string
        && data.weekStart.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.days is list
        && data.days.size() == 7
        && data.sourceFingerprint is string
        && data.savedBy == request.auth.uid
        && data.savedAt == request.time;
    }

    function validPlanningSettings(data) {
      return data.keys().hasOnly(['dinnerTarget', 'costcoThisWeek', 'updatedBy', 'updatedAt'])
        && data.dinnerTarget is int
        && data.dinnerTarget >= 0
        && data.dinnerTarget <= 6
        && data.costcoThisWeek is bool
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validRecurringProfile(data) {
      return data.keys().hasOnly(['personId', 'name', 'condition', 'enabled', 'ingredients', 'updatedBy', 'updatedAt'])
        && validPersonId(data.personId)
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.condition == 'home'
        && data.enabled is bool
        && data.ingredients is list
        && data.ingredients.size() > 0
        && data.ingredients.size() <= 30
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validRecurringFood(data) {
      return data.keys().hasOnly(['name', 'kind', 'timesPerWeek', 'enabled', 'recipeId', 'servings', 'ingredient', 'person', 'mealType', 'weekdays', 'onlyWhenHome', 'updatedBy', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && (data.kind == 'recipe' || data.kind == 'item')
        && data.timesPerWeek is int
        && data.timesPerWeek >= 0
        && data.timesPerWeek <= 21
        && data.enabled is bool
        && (data.recipeId == null || data.recipeId is string)
        && (data.servings == null || (data.servings is int && data.servings >= 1 && data.servings <= 12))
        && (data.ingredient == null || data.ingredient is map)
        && (data.person == null || data.person == 'alex' || data.person == 'nathalia' || data.person == 'both')
        && (data.mealType == null || data.mealType == 'breakfast' || data.mealType == 'lunch' || data.mealType == 'dinner' || data.mealType == 'snack' || data.mealType == 'grocery')
        && (data.weekdays == null || data.weekdays is list)
        && (data.onlyWhenHome == null || data.onlyWhenHome is bool)
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validMealOverride(data) {
      return data.keys().hasOnly(['date', 'mealType', 'kind', 'recipeId', 'servings', 'updatedBy', 'updatedAt'])
        && data.date is string
        && (data.mealType == 'lunch' || data.mealType == 'dinner')
        && (data.kind == 'recipe' || data.kind == 'leftovers' || data.kind == 'eat_out' || data.kind == 'skip')
        && (data.recipeId == null || data.recipeId is string)
        && (data.servings == null || (data.servings is int && data.servings >= 0 && data.servings <= 12))
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validShoppingTrip(data) {
      return data.keys().hasOnly(['store', 'date', 'updatedBy', 'updatedAt'])
        && (data.store == 'King Soopers' || data.store == 'Costco')
        && data.date is string
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validFoodGoals(data) {
      return data.keys().hasOnly(['proteinForward', 'vegetablesDaily', 'seasonalPriority', 'maxWeeknightMinutes', 'adventurousness', 'avoidIngredients', 'notes', 'updatedBy', 'updatedAt'])
        && data.proteinForward is bool
        && data.vegetablesDaily is bool
        && data.seasonalPriority is bool
        && data.maxWeeknightMinutes is int
        && data.maxWeeknightMinutes >= 10
        && data.maxWeeknightMinutes <= 90
        && data.adventurousness is int
        && data.adventurousness >= 1
        && data.adventurousness <= 5
        && data.avoidIngredients is string
        && data.notes is string
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validStorePreference(data) {
      return data.keys().hasOnly(['itemId', 'name', 'preferredStore', 'bulkMode', 'packageQuantity', 'packageUnit', 'shelfLifeDays', 'freezable', 'updatedBy', 'updatedAt'])
        && data.itemId is string && data.name is string
        && (data.preferredStore == 'auto' || data.preferredStore == 'King Soopers' || data.preferredStore == 'Costco')
        && (data.bulkMode == 'auto' || data.bulkMode == 'always' || data.bulkMode == 'never')
        && (data.packageQuantity == null || (data.packageQuantity is number && data.packageQuantity > 0))
        && (data.packageUnit == null || data.packageUnit is string)
        && (data.shelfLifeDays == null || (data.shelfLifeDays is int && data.shelfLifeDays > 0 && data.shelfLifeDays <= 730))
        && data.freezable is bool
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }

    function validRecipe(data) {
      return data.keys().hasOnly([
          'name', 'mealType', 'description', 'cuisine', 'protein', 'method',
          'effortMinutes', 'servings', 'lateNightSuitable', 'tags',
          'ingredients', 'instructions', 'favorite', 'rating', 'note', 'color',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && (data.mealType == 'lunch' || data.mealType == 'dinner')
        && data.description is string
        && data.cuisine is string
        && data.protein is string
        && data.method is string
        && data.effortMinutes is int
        && data.effortMinutes >= 1
        && data.effortMinutes <= 180
        && data.servings is int
        && data.servings >= 1
        && data.servings <= 12
        && data.lateNightSuitable is bool
        && data.tags is list
        && data.ingredients is list
        && data.ingredients.size() > 0
        && data.instructions is list
        && data.instructions.size() > 0
        && data.favorite is bool
        && data.rating is int
        && data.rating >= 0
        && data.rating <= 5
        && data.note is string
        && data.note.size() <= 500
        && data.color is string
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedBy is string
        && data.updatedAt is timestamp;
    }

    function validInventory(data) {
      return data.keys().hasOnly([
          'itemId', 'name', 'quantity', 'unit', 'confidence', 'lastConfirmedAt',
          'updatedBy', 'updatedAt'
        ])
        && data.itemId is string
        && data.itemId.size() > 0
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.quantity is number
        && data.quantity >= 0
        && data.unit is string
        && data.unit.size() > 0
        && data.confidence is int
        && data.confidence >= 0
        && data.confidence <= 100
        && data.lastConfirmedAt is timestamp
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validGroceryRun(data) {
      return data.keys().hasOnly([
          'weekStart', 'items', 'calculationFingerprint', 'createdBy', 'createdAt',
          'updatedBy', 'updatedAt'
        ])
        && data.weekStart is string
        && data.weekStart.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.items is list
        && data.items.size() <= 250
        && data.calculationFingerprint is string
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validPurchaseTransaction(data) {
      return data.keys().hasOnly([
          'kind', 'itemId', 'name', 'quantity', 'unit', 'groceryRunId',
          'groceryItemId', 'createdBy', 'createdAt'
        ])
        && data.kind == 'purchase'
        && data.itemId is string
        && data.name is string
        && data.quantity is number
        && data.quantity > 0
        && data.unit is string
        && data.groceryRunId is string
        && data.groceryItemId is string
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time;
    }

    function validConsumptionTransaction(data) {
      return data.keys().hasOnly([
          'kind', 'mealId', 'deductions', 'createdBy', 'createdAt'
        ])
        && data.kind == 'confirmed_consumption'
        && data.mealId is string
        && data.deductions is list
        && data.deductions.size() > 0
        && data.deductions.size() <= 50
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time;
    }

    function validMealCompletion(data) {
      return data.keys().hasOnly([
          'date', 'mealType', 'recipeId', 'recipeName', 'servings', 'status',
          'deductions', 'completedBy', 'completedAt'
        ])
        && data.date is string
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (data.mealType == 'lunch' || data.mealType == 'dinner')
        && data.recipeId is string
        && data.recipeName is string
        && data.servings is number
        && data.servings >= 0
        && (data.status == 'cooked' || data.status == 'leftovers'
          || data.status == 'eat_out' || data.status == 'skipped')
        && data.deductions is list
        && data.deductions.size() <= 50
        && data.completedBy == request.auth.uid
        && data.completedAt == request.time;
    }

    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);
      allow create, update, delete: if false;

      match /members/{memberId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if false;
      }

      match /scheduleExceptions/{exceptionId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId)
          && validNewScheduleException(request.resource.data);
        allow update: if isHouseholdMember(householdId)
          && validScheduleExceptionFields(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isHouseholdMember(householdId);
      }

      match /mealPlans/{weekStart} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && validMealPlan(request.resource.data)
          && request.resource.data.weekStart == weekStart;
        allow delete: if false;
      }

      match /planningSettings/{settingsId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && settingsId == 'current'
          && validPlanningSettings(request.resource.data);
        allow delete: if false;
      }

      match /recurringProfiles/{profileId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && validRecurringProfile(request.resource.data);
        allow delete: if false;
      }

      match /recurringFoods/{foodId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && validRecurringFood(request.resource.data);
        allow delete: if isHouseholdMember(householdId);
      }

      match /mealOverrides/{date} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId) && validMealOverride(request.resource.data);
        allow delete: if isHouseholdMember(householdId);
      }

      match /shoppingTrips/{tripId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId) && validShoppingTrip(request.resource.data);
        allow delete: if false;
      }

      match /aiSettings/{settingsId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && settingsId == 'foodGoals'
          && validFoodGoals(request.resource.data);
        allow delete: if false;
      }

      match /storePreferences/{itemId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId) && validStorePreference(request.resource.data);
        allow delete: if isHouseholdMember(householdId);
      }

      match /aiGenerationRequests/{requestId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId)
          && request.resource.data.keys().hasOnly(['weekStart', 'season', 'scope', 'status', 'requestedBy', 'requestedAt'])
          && request.resource.data.scope == 'full_plan'
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.requestedAt == request.time;
        allow update: if isHouseholdMember(householdId)
          && resource.data.requestedBy == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'failed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'errorMessage', 'completedAt'])
          && request.resource.data.completedAt == request.time;
        allow delete: if false;
      }

      match /aiPlanningBriefs/{weekStart} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if false;
      }

      match /aiWeeklyDrafts/{weekStart} {
        allow read: if isHouseholdMember(householdId);
        allow create, delete: if false;
        allow update: if isHouseholdMember(householdId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
          && (request.resource.data.status == 'applied' || request.resource.data.status == 'dismissed')
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time;
      }

      match /aiRecipeProposals/{proposalId} {
        allow read: if isHouseholdMember(householdId);
        allow create, delete: if false;
        allow update: if isHouseholdMember(householdId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
          && (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected')
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time;
      }

      match /recipes/{recipeId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId)
          && validRecipe(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow update: if isHouseholdMember(householdId)
          && validRecipe(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if isHouseholdMember(householdId);
      }

      match /inventory/{inventoryId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && validInventory(request.resource.data);
        allow delete: if false;
      }

      match /groceryRuns/{weekStart} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId)
          && validGroceryRun(request.resource.data)
          && request.resource.data.weekStart == weekStart
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if isHouseholdMember(householdId)
          && validGroceryRun(request.resource.data)
          && request.resource.data.weekStart == weekStart
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /inventoryTransactions/{transactionId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && (validPurchaseTransaction(request.resource.data)
            || validConsumptionTransaction(request.resource.data));
        allow delete: if isHouseholdMember(householdId);
      }

      match /mealCompletions/{completionId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && validMealCompletion(request.resource.data);
        allow delete: if isHouseholdMember(householdId);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
