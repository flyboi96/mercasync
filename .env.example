# D1 remains the default until Firebase is explicitly selected.
NEXT_PUBLIC_DATA_BACKEND=d1

# Safe local Firebase defaults. These identify the demo emulator project and
# are not credentials. Set USE_EMULATORS=false only with a real web app config.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mercasync
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mercasync.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:mercasync-local
NEXT_PUBLIC_FIREBASE_HOUSEHOLD_ID=mercasync-home
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_AI_DISPATCH_URL=http://localhost:8788

# The GitHub Pages workflow needs the real PROJECT_ID, API_KEY, AUTH_DOMAIN,
# APP_ID, and HOUSEHOLD_ID values as repository Actions variables. Never add a
# service-account key, Admin SDK credential, account password, email, or UID.
