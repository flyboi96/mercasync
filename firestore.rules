rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function householdData(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function isHouseholdMember(householdId) {
      return signedIn()
        && request.auth.uid in householdData(householdId).memberIds;
    }

    function validPersonId(personId) {
      return personId == 'alex' || personId == 'nathalia';
    }

    function validExceptionKind(kind) {
      return kind == 'home'
        || kind == 'late_shift'
        || kind == 'work_trip'
        || kind == 'day_off'
        || kind == 'holiday'
        || kind == 'away';
    }

    function validScheduleExceptionFields(data) {
      return data.keys().hasOnly([
          'personId', 'kind', 'date', 'title', 'location', 'createdBy', 'createdAt'
        ])
        && validPersonId(data.personId)
        && validExceptionKind(data.kind)
        && data.date is string
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && (data.location == null || data.location is string);
    }

    function validNewScheduleException(data) {
      return validScheduleExceptionFields(data)
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time;
    }

    function validMealPlan(data) {
      return data.keys().hasOnly([
          'weekStart', 'days', 'sourceFingerprint', 'savedBy', 'savedAt'
        ])
        && data.weekStart is string
        && data.weekStart.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.days is list
        && data.days.size() == 7
        && data.sourceFingerprint is string
        && data.savedBy == request.auth.uid
        && data.savedAt == request.time;
    }

    function validRecipe(data) {
      return data.keys().hasOnly([
          'name', 'mealType', 'description', 'cuisine', 'protein', 'method',
          'effortMinutes', 'servings', 'lateNightSuitable', 'tags',
          'ingredients', 'instructions', 'favorite', 'rating', 'note', 'color',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && (data.mealType == 'lunch' || data.mealType == 'dinner')
        && data.description is string
        && data.cuisine is string
        && data.protein is string
        && data.method is string
        && data.effortMinutes is int
        && data.effortMinutes >= 1
        && data.effortMinutes <= 180
        && data.servings is int
        && data.servings >= 1
        && data.servings <= 12
        && data.lateNightSuitable is bool
        && data.tags is list
        && data.ingredients is list
        && data.ingredients.size() > 0
        && data.instructions is list
        && data.instructions.size() > 0
        && data.favorite is bool
        && data.rating is int
        && data.rating >= 0
        && data.rating <= 5
        && data.note is string
        && data.note.size() <= 500
        && data.color is string
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedBy is string
        && data.updatedAt is timestamp;
    }

    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);
      allow create, update, delete: if false;

      match /members/{memberId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if false;
      }

      match /scheduleExceptions/{exceptionId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId)
          && validNewScheduleException(request.resource.data);
        allow update: if isHouseholdMember(householdId)
          && validScheduleExceptionFields(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isHouseholdMember(householdId);
      }

      match /mealPlans/{weekStart} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && validMealPlan(request.resource.data)
          && request.resource.data.weekStart == weekStart;
        allow delete: if false;
      }

      match /recipes/{recipeId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId)
          && validRecipe(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow update: if isHouseholdMember(householdId)
          && validRecipe(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'favorite', 'rating', 'note', 'updatedBy', 'updatedAt'
          ])
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
